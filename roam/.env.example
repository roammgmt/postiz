# Outpost · Social — Postiz environment (template)
# Copy to roam/.env and fill in. NEVER commit the real .env.
#
# Generate secrets with:  openssl rand -hex 32

# ── Public URLs ──────────────────────────────────────────────
MAIN_URL=https://social.roam.example.com
FRONTEND_URL=https://social.roam.example.com
NEXT_PUBLIC_BACKEND_URL=https://social.roam.example.com/api

# Host port the app container publishes (mapped to container :5000).
POSTIZ_HTTP_PORT=4007

# ── Secrets ──────────────────────────────────────────────────
JWT_SECRET=change-me-openssl-rand-hex-32

# ── Postiz database (Prisma / PostgreSQL) ────────────────────
POSTGRES_USER=postiz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postiz

# ── Temporal's own Postgres (separate from Postiz's) ─────────
TEMPORAL_PG_USER=temporal
TEMPORAL_PG_PASSWORD=change-me

# ── Posture ──────────────────────────────────────────────────
# Single-tenant v1: lock registration so only our provisioning creates accounts.
DISABLE_REGISTRATION=true

# ── Storage ──────────────────────────────────────────────────
# `local` uses the uploads volume. Switch to `cloudflare` (R2) for off-box media.
STORAGE_PROVIDER=local

# ── Provider OAuth keys (added per platform when connecting channels) ─────
# Leave blank until you connect a channel. Meta is the long pole.
# X_API_KEY=
# X_API_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
